{
  "manifest_version": 3,
  "name": "MUJ SLCM Enhanced",
  "short_name": "MUJX",
  "version": "1.0.0",
  "description": "Automate attendance math, track safe skips, total internal marks, predict your CGPA, and organize your dashboard in MUJ SLCM.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MUJ SLCM Enhanced",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/settings/settings.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://mujslcm.jaipur.manipal.edu/*",
    "*://muj.slcm.jaipur.manipal.edu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://mujslcm.jaipur.manipal.edu/Student/Academic/AttendanceSummaryForStudent*",
        "*://muj.slcm.jaipur.manipal.edu/Student/Academic/AttendanceSummaryForStudent*"
      ],
      "js": ["src/content/attendance.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://mujslcm.jaipur.manipal.edu/Student/Academic/InternalMarkForStudent*",
        "*://muj.slcm.jaipur.manipal.edu/Student/Academic/InternalMarkForStudent*"
      ],
      "js": ["src/content/marks_sum.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://mujslcm.jaipur.manipal.edu/Student/Academic/GradesForStudent*",
        "*://muj.slcm.jaipur.manipal.edu/Student/Academic/GradesForStudent*"
      ],
      "js": ["src/content/grades_parser.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://mujslcm.jaipur.manipal.edu/Student/Academic/ViewTimeTableForStudent*",
        "*://muj.slcm.jaipur.manipal.edu/Student/Academic/ViewTimeTableForStudent*"
      ],
      "js": ["src/content/timetable.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://mujslcm.jaipur.manipal.edu/Student/Academic/CGPAGPAForStudent*",
        "*://muj.slcm.jaipur.manipal.edu/Student/Academic/CGPAGPAForStudent*"
      ],
      "js": ["src/content/cgpa_predictor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://mujslcm.jaipur.manipal.edu/Home/Dashboard*",
        "*://muj.slcm.jaipur.manipal.edu/Home/Dashboard*"
      ],
      "js": ["src/content/dashboard.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/timetable.js",
        "icons/*"
      ],
      "matches": [
        "*://mujslcm.jaipur.manipal.edu/*",
        "*://muj.slcm.jaipur.manipal.edu/*"
      ]
    }
  ]
}
