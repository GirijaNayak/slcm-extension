{
  "manifest_version": 3,
  "name": "MUJ SLCM Enhanced",
  "short_name": "MUJX",
  "version": "1.0.0",
  "description": "In-place attendance, marks, SGPA, CGPA, timetable, and notification enhancements for the MUJ SLCM portal.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MUJ SLCM Enhanced",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/settings/settings.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://mujslcm.jaipur.manipal.edu/*",
    "https://muj.slcm.jaipur.manipal.edu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mujslcm.jaipur.manipal.edu/*",
        "https://muj.slcm.jaipur.manipal.edu/*"
      ],
      "js": ["dist/content.bundle.js"],
      "css": ["src/ui/styles.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/styles.css",
        "icons/*"
      ],
      "matches": [
        "https://mujslcm.jaipur.manipal.edu/*",
        "https://muj.slcm.jaipur.manipal.edu/*"
      ]
    }
  ]
}
